# Copy to .env.local and fill in. Never commit real values (the repo is public).
# Phase 4 (lead flow). All of these are read on the server only: none starts with NEXT_PUBLIC_.

# Supabase (EU, Ireland). Settings > API Keys. The secret key bypasses RLS: server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend. An API key with "Sending access" only.
RESEND_API_KEY=
# live: sends to anyone. sandbox: sends only to EMAIL_SANDBOX_ALLOWLIST and the UI never says "sent" otherwise.
EMAIL_MODE=sandbox
EMAIL_SANDBOX_ALLOWLIST=
# Sender on the verified domain, e.g. "ETF Kompas (test) <kompas@send.example.com>"
EMAIL_FROM=
EMAIL_REPLY_TO=

# Public address of the site, used in links in e-mails (no trailing slash).
SITE_URL=http://localhost:3000

# Random secrets, at least 32 bytes each, e.g. `openssl rand -base64 32`. Different values.
# IP_HASH_SECRET: with the date it gives the daily-rotating salt for hashed IPs.
IP_HASH_SECRET=
# TOKEN_SIGNING_SECRET: signs the opt-in and unsubscribe links.
TOKEN_SIGNING_SECRET=

# Phase 5 (tracking). Both optional and not secret; read when the page is built. Without them
# only the first-party events run. GA4: Admin > Data streams > Measurement ID (G-XXXXXXXXXX).
# Meta: Events Manager > the dataset's ID (digits).
GA4_MEASUREMENT_ID=
META_PIXEL_ID=

# Phase 5 (Meta Conversions API, the server-side Lead). All three are needed, with META_PIXEL_ID
# above. Meta's access token is a secret: server only, never NEXT_PUBLIC_. There is no default
# Graph API version: read the current one from Meta's documentation when the account exists.
META_CAPI_TOKEN=
META_GRAPH_VERSION=
